const Mem = import("../Mem.func");
const Process = import("../Process.func");
const Thread = Process.Thread;
const Mutex = Thread.Mutex;
const Condition = Thread.Condition;
const DateTime = import("DateTime.func");

code(
'''
const std = @import("std");

pub fn t(comptime T: type) type {
    return struct {
        const Self = @This();

        mem: *Mem,
        list: std.ArrayList(T) = .empty,
        max_count: usize = std.math.maxInt(usize), // Max count of item in the queue
        closed: bool = false,
        mutex: Mutex,
        not_empty: Condition,
        not_full: Condition,

        /// free memory by caller.
        pub fn a(mem: *Mem) Self {
            return Self{
                .mem = mem,
                .mutex = Mutex.a(mem),
                .not_empty = Condition.a(mem),
                .not_full = Condition.a(mem),
            };
        }
        pub fn a2(mem: *Mem, max_count: usize) Self {
            return Self{
                .mem = mem,
                .max_count = max_count,
                .mutex = Mutex.a(mem),
                .not_empty = Condition.a(mem),
                .not_full = Condition.a(mem),
            };
        }

        /// Blocks if the queue is full. Returns error.Closed if the bus is closed.
        pub fn add(self: *Self, item: T) !void {
            self.mutex.lock();
            defer self.mutex.unlock();

            while (self.list.items.len == self.max_count and !self.closed) {
                self.not_full.wait(&self.mutex);
            }

            if (self.closed) return error.Closed;

            try self.list.append(self.mem.allocator(), item);

            self.not_empty.signal();
        }

        pub fn add2(self: *Self, item: T, timeout_ms: u32) !void {
            self.mutex.lock();
            defer self.mutex.unlock();

            const deadline_ns: i128 = DateTime.nanoTimestamp() +
                (@as(i128, @intCast(timeout_ms)) * std.time.ns_per_ms);
            while (self.list.items.len == self.max_count and !self.closed) {
                const remaining_ns = remainingTimeoutNs(deadline_ns);
                if (remaining_ns == 0) return error.Timeout;
                self.mutex.unlock();
                Thread.sleep(@intCast(@min(remaining_ns, 10 * std.time.ns_per_ms)));
                self.mutex.lock();
            }
            if (self.closed) return error.Closed;

            try self.list.append(self.mem.allocator(), item);

            self.not_empty.signal();
        }

        pub fn count(self: *Self) usize {
            self.mutex.lock();
            defer self.mutex.unlock();
            return self.list.items.len;
        }

        /// Blocks if the queue is empty. Returns null if closed and the queue is empty.
        pub fn pop(self: *Self) ?T {
            self.mutex.lock();
            defer self.mutex.unlock();

            while (self.list.items.len == 0 and !self.closed) {
                self.not_empty.wait(&self.mutex);
            }
            if (self.list.items.len == 0) return null; // closed + drained

            const item = self.list.orderedRemove(0);
            self.not_full.signal();
            return item;
        }

        pub fn pop2(self: *Self, timeout_ms: u32) error{Timeout}!?T {
            self.mutex.lock();
            defer self.mutex.unlock();

            const deadline_ns: i128 = DateTime.nanoTimestamp() +
                (@as(i128, @intCast(timeout_ms)) * std.time.ns_per_ms);

            while (self.list.items.len == 0 and !self.closed) {
                const remaining_ns = remainingTimeoutNs(deadline_ns);
                if (remaining_ns == 0) return error.Timeout;
                self.mutex.unlock();
                Thread.sleep(@intCast(@min(remaining_ns, 10 * std.time.ns_per_ms)));
                self.mutex.lock();
            }

            if (self.list.items.len == 0) return null;

            const item = self.list.orderedRemove(0);
            self.not_full.signal();
            return item;
        }

        /// Closes the queue, waking all waiting threads.
        pub fn close(self: *Self) void {
            self.mutex.lock();
            defer self.mutex.unlock();
            self.closed = true;
            self.not_empty.broadcast();
            self.not_full.broadcast();
        }

        pub fn d(self: *Self) void {
            self.mutex.lock();
            defer self.mutex.unlock();
            self.closed = true;
            self.not_empty.broadcast();
            self.not_full.broadcast();
            self.list.deinit(self.mem.allocator());
        }

        fn remainingTimeoutNs(deadline_ns: i128) u64 {
            const remaining_ns = deadline_ns - DateTime.nanoTimestamp();
            if (remaining_ns <= 0) return 0;
            return @intCast(remaining_ns);
        }
    };
}
'''
);
