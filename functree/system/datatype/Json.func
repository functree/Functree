const Mem = import("../Mem.func");
const DataType = import("../DataType.func");
const String = DataType.String;

pub const JsonMap = import("json/JsonMap.func");
pub const JsonList = import("json/JsonList.func");

code(
'''
const std = @import("std");
pub const JsonValue = std.json.Value;

/// value include: null, bool: bool, integer: i64, float: f64, string: []const u8, JsonList, JsonMap
pub fn getJsonValue(mem: *Mem, value: anytype) !*JsonValue {
    var json_value = try mem.alloc(JsonValue);
    const T = DataType.typeOf(value);
    const ty = DataType.typeInfo(T);
    switch (ty) {
        .null => json_value.* = .null,
        .bool => json_value.* = .{.bool = value},
        .int, .comptime_int, .float, .comptime_float => {
            const string = try String.formatStr(mem, "{d}", .{value});
            const val = parseFromNumberSlice(string);
            if (val != .number_string) {
                defer mem.free2(string);
            }
            json_value.* = val;
        },
        .optional => {
            if (value) |val| {
                json_value = try getJsonValue(mem, val);
            } else {
                json_value.* = .null;
            }
        },
        .pointer => {
            const type_info = ty.pointer;
            switch (type_info.size) {
                .one => {
                    const ty_child = @typeInfo(type_info.child);
                    switch (ty_child) {
                        .array => {
                            defer mem.free(json_value);
                            // Coerce `*[N]T` to `[]const T`.
                            const Slice = []const std.meta.Elem(type_info.child);
                            return try getJsonValue(mem, @as(Slice, value));
                        },
                        else => {
                            defer mem.free(json_value);
                            return try getJsonValue(mem, value.*);
                        },
                    }
                },
                .many, .slice => {
                    if (type_info.size == .many and type_info.sentinel() == null)
                        return error.UnableHandlePointerTypeWithoutSentinel;
                    const slice = if (type_info.size == .many) std.mem.span(value) else value;

                    if (type_info.child == u8) {
                        // This is a []const u8, or some similar Zig string.
                        if (std.unicode.utf8ValidateSlice(slice)) {
                            json_value.* = .{.string = value};
                            return json_value;
                        }
                    }

                    for (slice) |x| {
                        defer mem.free(json_value);
                        return try getJsonValue(mem, x);
                    }
                },
                else => return error.UnableHandlePointerType,
            }
        },
        .@"struct" => {
            // only JsonMap or JsonList
            if (@hasField(T, "object")) {
                json_value.* = .{.object = value.object};
            } else if (@hasField(T, "array")) {
                json_value.* = .{.array = value.array};
            } else {
                return error.NoSupportStructValueType;
            }
        },
        else => {
            return error.NoSupportValueType;
        },
    }
    return json_value;
}
fn parseFromNumberSlice(s: []const u8) JsonValue {
    if (!isNumberFormattedLikeAnInteger(s)) {
        const f = std.fmt.parseFloat(f64, s) catch unreachable;
        if (std.math.isFinite(f)) {
            return JsonValue{ .float = f };
        } else {
            return JsonValue{ .number_string = s };
        }
    }
    if (std.fmt.parseInt(i64, s, 10)) |i| {
        return JsonValue{ .integer = i };
    } else |e| {
        switch (e) {
            error.Overflow => return JsonValue{ .number_string = s },
            error.InvalidCharacter => unreachable,
        }
    }
}
/// This function returns true if the number doesn't contain any fraction or exponent components, and is not `-0`.
/// Note, the numeric value encoded by the value may still be an integer, such as `1.0`.
/// This function is meant to give a hint about whether integer parsing or float parsing should be used on the value.
/// This function will not give meaningful results on non-numeric input.
fn isNumberFormattedLikeAnInteger(value: []const u8) bool {
    if (std.mem.eql(u8, value, "-0")) return false;
    return std.mem.findAny(u8, value, ".eE") == null;
}
'''
);

pub fn toStr(buffer: []u8, value: anytype) ![]u8 {
    var w: std.Io.Writer = .fixed(buffer);
    try std.json.Stringify.value(value, .{}, &w);
    return w.buffered();
}

