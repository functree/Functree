test "String: isNumberStr" {
    const testCases: []str = [
        "123",    // true
        "-123",   // true
        "+123",   // true
        "12.34",  // true
        "-12.34", // true
        ".123",   // true
        "123.",   // true
        "+.123",  // true
        "",       // false
        "abc",    // false
        "12.34.56", // false
        "--123",  // false
        "12a34",  // false
    ];

    for (testCases) |case| {
        Console.print2("Is '{s}' a number? {any}\n", .{case, String.isNumberStr(case)});
    }
}

