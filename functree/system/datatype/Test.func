test "Tensor: stack" {
    // init heap memory
    var mem = Mem.a();
    mem.f();
    defer mem.d();

    var tensor1 = try Tensor.a(&mem, &[2, 2]);
    defer tensor1.d();
    tensor1.set(&[0, 0], 1.0);
    tensor1.set(&[0, 1], 2.0);
    tensor1.set(&[1, 0], 3.0);
    tensor1.set(&[1, 1], 4.0);

    var tensor2 = try Tensor.a(&mem, &[2, 2]);
    defer tensor2.d();
    tensor2.set(&[0, 0], 5.0);
    tensor2.set(&[0, 1], 6.0);
    tensor2.set(&[1, 0], 7.0);
    tensor2.set(&[1, 1], 8.0);

    var t5 = try Tensor.stack(&[tensor1, tensor2], 0);
    defer t5.d();
    Console.print2("\n{s}:\n", .{"Tensor stack, dim=0"});
    try t5.print();
    var t6 = try Tensor.stack(&[tensor1, tensor2], 1);
    defer t6.d();
    Console.print2("\n{s}:\n", .{"Tensor stack, dim=1"});
    try t6.print();
    var t7 = try Tensor.stack(&[tensor1, tensor2], 2);
    defer t7.d();
    Console.print2("\n{s}:\n", .{"Tensor stack, dim=2"});
    try t7.print();
}
