const System = import("../../System.func");
const DataType = System.DataType;
const Mem = System.Mem;
const Math = System.Math;
const Console = System.Io.Console;

const FunctreeTest = import("../../Test.func");
const expect = FunctreeTest.expect;
const expectEqual = FunctreeTest.expectEqual;
const expectEqualSlices = FunctreeTest.expectEqualSlices;
const expectEqualStrings = FunctreeTest.expectEqualStrings;


test "DataType: ptrFromInt and intFromPtr" {
    const mmio_ptr: *volatile u8 = DataType.ptrFromInt(*volatile u8, 0x12345678);
    code('''try expect(DataType.typeOf(mmio_ptr) == *volatile u8);''');

    const ptr: *allowzero i32 = DataType.ptrFromInt(*allowzero i32, 0);
    try expect(DataType.intFromPtr(ptr) == 0);
}

const Date = DataType.Date;
test "Date: a addYear" {
    var date = try Date.a(2025, 1, 6);

    date.addYear(1);
    try expect(date.year == 2026);

    date.addYear(-1);
    try expect(date.year == 2025);
}
test "Date: a addMonth" {
    var date = try Date.a(2025, 1, 6);

    date.addMonth(13);
    try expect(date.year == 2026);
    try expect(date.month == 2);

    date.addMonth(-5);
    try expect(date.year == 2025);
    try expect(date.month == 9);
}
test "Date: a addDay" {
    var date = try Date.a(2025, 1, 6);

    date.addDay(-8);
    try expect(date.year == 2024);
    try expect(date.month == 12);
    try expect(date.day == 29);

    date.addDay(10);
    try expect(date.year == 2025);
    try expect(date.month == 1);
    try expect(date.day == 8);
}

test "Date: compare" {
    const date = try Date.parse("2025-1-6 9:5:8");
    var date2 = try Date.parse("2025-1-6 9:5:8");
    try expect(date.compare(date2) == 0);
    date2.addDay(-1);
    try expect(date.compare(date2) == 1);
    date2.addDay(2);
    try expect(date.compare(date2) == -1);
}

test "Date: dayInterval" {
    const date = try Date.parse("2025-01-06");
    const date2 = try Date.parse("2025-01-03");
    const day_interval = date.dayInterval(date2);
    try expect(day_interval == 3);
}

test "Date: equal" {
    const date = try Date.parse("2025-1-6");
    var date2 = try Date.parse("2025-1-6");
    try expect(date.equal(date2));
    date2.addDay(1);
    try expect(!date.equal(date2));
}

test "Date: parse" {
    const date = try Date.parse("2025-1-6");
    try expect(date.year == 2025);
    try expect(date.month == 1);
    try expect(date.day == 6);

    const date2 = try Date.parse("2025-01-06");
    try expect(date2.year == 2025);
    try expect(date2.month == 1);
    try expect(date2.day == 6);
}
test "Date: parse2" {
    const date = try Date.parse2("2025-01-06", "y-mm-dd");
    try expect(date.year == 2025);
    try expect(date.month == 1);
    try expect(date.day == 6);

    const date2 = try Date.parse2("1-6/2025", "m-d/y");
    try expect(date2.year == 2025);
    try expect(date2.month == 1);
    try expect(date2.day == 6);
}

test "Date: today" {
    var date = try Date.today();
    date.setTimezone(.utc8);
    var buffer: [20]u8 = undefined;
    const date_str = date.toStr(&buffer);
    Console.println(date_str);

    try expect(date.year == 2026);
    // try expect(date.month == 1);
    //try expect(date.day == 18);
}

test "Date: a toStr" {
    const date = try Date.a(-2025, 1, 6);
    var buffer: [20]u8 = undefined;

    const date_str = date.toStr(&buffer);
    try expectEqualSlices(u8, "-2025-01-06", date_str);
}
test "Date: a toStr2" {
    const date = try Date.a(2025, 1, 6);
    var buffer: [20]u8 = undefined;

    const date_str = try date.toStr2(&buffer, "y-m-d");
    try expectEqualSlices(u8, "2025-1-6", date_str);

    const date_str2 = try date.toStr2(&buffer, "y-mm-dd 00:00:00");
    try expectEqualSlices(u8, "2025-01-06 00:00:00", date_str2);

    const date_str3 = try date.toStr2(&buffer, "m-d/y");
    try expectEqualSlices(u8, "1-6/2025", date_str3);
}

test "Date: toTimestamp" {
    const date= try Date.today();
    const ts = date.toTimestamp();
    Console.print2("{d}\n", .{ts});
}

test "Date: toMilliTimestamp" {
    const date = try Date.today();
    const ts = date.toMilliTimestamp();
    Console.print2("{d}\n", .{ts});
}


const DateTime = DataType.DateTime;
test "DateTime: a addYear" {
    var datetime = try DateTime.parse2("2025-01-06 09:05:03.008", "y-mm-dd hh:ii:ss.ll");

    datetime.addYear(1);
    try expect(datetime.year == 2026);

    datetime.addYear(-1);
    try expect(datetime.year == 2025);
}
test "DateTime: a addMonth" {
    var datetime = try DateTime.parse2("2025-01-06 09:05:03.008", "y-mm-dd hh:ii:ss.ll");

    datetime.addMonth(13);
    try expect(datetime.year == 2026);
    try expect(datetime.month == 2);

    datetime.addMonth(-5);
    try expect(datetime.year == 2025);
    try expect(datetime.month == 9);
}
