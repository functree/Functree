    const d8 = Integer.minValue(u32);
    const d9 = Integer.maxValue(u32);

    try expect(d8==0);
    try expect(d9==4294967295);
}


const Json = DataType.Json;
const JsonObject = Json.JsonObject;
const JsonArray = Json.JsonArray;
pub const JsonValue = Json.JsonValue;
test "Json: a JsonObject" {
    // init heap memory
    var mem = Mem.a();
    mem.f();
    defer mem.d();

    var object = JsonObject.a(&mem);
    try object.add("string", "abc");
    try object.add("integer", 23);
    const large_number: u64 = 18446744073709551615;
    try object.add("number_string", large_number);

    const actual = try object.toStr();
    const expected = "{\"string\":\"abc\",\"integer\":23,\"number_string\":18446744073709551615}";
    try expectEqualStrings(expected, actual);
}
test "Json: JsonObject parse str" {
    const json_str =
        '''
        {
          "Image": {
              "Width":  800,
              "Height": 600,
              "Title":  "View from 15th Floor",
              "File":  null,
              "Thumbnail": {
                  "Url":    "http://www.example.com/image/481989943",
                  "Height": 125,
                  "Width":  100
              },
              "Animated" : false,
              "IDs": [116, 943, 234, 38793],
              "ArrayOfObject": [{"n": "m"}],
              "double": 1.3412,
              "LargeInt": 18446744073709551615
            }
        }
        '''
    ;
    // init heap memory
     var mem = Mem.a();
    mem.f();
    defer mem.d();

    const json_object = try JsonObject.parse(&mem, json_str);

    const image = json_object.getJsonObject("Image").?;

    try expect(image.getInteger("Width").? == 800);

    try expect(image.get("File").?.null == {});

    try expect(image.getBool("Animated").? == false);

    const ids = image.getJsonArray("IDs").?;
    try expect(ids.values()[1].integer == 943);

    const array_of_object = image.getJsonArray("ArrayOfObject").?;
    try expect(String.equalStr(array_of_object.values()[0].object.get("n").?.string, "m"));

    const double = image.getFloat("double").?;
    try expect(double == 1.3412);

    const large_int_str = image.getNumberString("LargeInt").?;
    try expect(String.equalStr(large_int_str, "18446744073709551615"));
}
test "Json: a JsonArray" {
    // init heap memory
    var mem = Mem.a();
    // auto free memory by arena
    mem.f();
    defer mem.d();

    var object = JsonObject.a(&mem);
    try object.add("a", "b");

    var array = Json.JsonArray.a(&mem);
    try array.add(1);
    try array.add(2);
    const i: i32 = 3;
    try array.add(i);
    try array.add(null);

    var array_parent = Json.JsonArray.a(&mem);
    try array_parent.add(true);
    try array_parent.add(42);
    try array_parent.add(4300000000000000);
    try array_parent.add(4.2);
    try array_parent.add("weeee");
    try array_parent.add(array);
    try array_parent.add(object);

    const actual = try array_parent.toStr();
    const expected = "[true,42,4300000000000000,4.2,\"weeee\",[1,2,3,null],{\"a\":\"b\"}]";
    try expectEqualStrings(expected, actual);
}
test "Json: JsonArray parse str" {
    // init heap memory
    var mem = Mem.a();
    mem.f();
    defer mem.d();

    const ids = "[116, 943, 234, 38793]";
    const array_ids = try JsonArray.parse(&mem, ids);
    try expect(array_ids.values()[1].integer == 943);

    const objects = "[{\"n\": \"m\"}]";
    const array_objects = try JsonArray.parse(&mem, objects);
    try expect(String.equalStr(array_objects.values()[0].object.get("n").?.string, "m"));
}

test "Json: parse" {
    const json_str =
        '''
        {
          "Image": {
              "Width":  800,
              "Height": 600,
              "Title":  "View from 15th Floor",
              "File":  null,
              "Thumbnail": {
                  "Url":    "http://www.example.com/image/481989943",
                  "Height": 125,
                  "Width":  100
              },
              "Animated" : false,
              "IDs": [116, 943, 234, 38793],
              "ArrayOfObject": [{"n": "m"}],
              "double": 1.3412,
              "LargeInt": 18446744073709551615
            }
        }
        '''
    ;
    // init heap memory
     var mem = Mem.a();
    mem.f();
    defer mem.d();

    const json_value = try Json.parse(&mem, json_str);

    const image = json_value.object.get("Image").?;

    try expect(image.object.get("Width").?.integer == 800);

    try expect(image.object.get("File").?.null == {});

    try expect(image.object.get("Animated").?.bool == false);

    const ids = image.object.get("IDs").?;
    try expect(ids.array.items[1].integer == 943);

    const array_of_object = image.object.get("ArrayOfObject").?;
    try expect(String.equalStr(array_of_object.array.items[0].object.get("n").?.string, "m"));

    const double = image.object.get("double").?;
    try expect(double.float == 1.3412);

    const large_int = image.object.get("LargeInt").?;
    try expect(String.equalStr(large_int.number_string, "18446744073709551615"));
}
test "Json: toStr" {
    var buffer: [10000]u8 = undefined;

    //JsonObject
    const actual = try Json.toStr(&buffer, .{ .foo = "bar", .answer = 42, .my_friend = "sammy" });
    const expected = "{\"foo\":\"bar\",\"answer\":42,\"my_friend\":\"sammy\"}";
    try expectEqualStrings(expected, actual);

    //JsonArray
    const Func = func {
        foo: u32,
    };
    //const value: []Func = [Func(foo=42), Func(foo=100), Func(foo=1000)];
    //const actual2 = try Json.toStr(&buffer, value);
    const actual2 = try Json.toStr(&buffer, [Func{.foo=42}, Func{.foo=100}, Func{.foo=1000}]);

    const expected2 = "[{\"foo\":42},{\"foo\":100},{\"foo\":1000}]";
    try expectEqualStrings(expected2, actual2);
}


const List = DataType.List;
test "List: a values()" {
    // init heap memory
    var mem = Mem.a();
    mem.f();
    defer mem.d();

    var list = List.t(u8).a(&mem);
    defer list.d();

    try list.add(1);
    try list.add(2);
    try list.add(3);
    for (list.values()) |item| {
        _ = item;
    }
    _ = list.count();
    try list.add2(1, 9);
    try expect(list.values()[1] == 9);

    var list2 = List.t(str).a(&mem);
    try list2.add("1");
    try list2.add("2");
    try list2.add("3");
    try expect(String.equalStr(list2.values()[1], "2"));

    var list3 = try list2.clone();
    try expect(String.equalStr(list3.values()[1], "2"));
}

test "List: a2 toArray" {
    // init heap memory
    var mem = Mem.a();
    mem.f();
    defer mem.d();

    var array: []u8 = [1,3,5];
    var list = try List.t(u8).a2(&mem, &array);
    defer list.d();

    for (list.values()) |item| {
        _ = item;
    }
    try expect(list.values()[1] == 3);

    try list.addArray2(2, &array);
    try expect(list.values().len == 6);

    const array2 = try list.toArray();
    try expect(array2[5] == 5);
}


