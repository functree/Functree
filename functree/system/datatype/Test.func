test "Tensor: 2D" {
    var buffer: [1000]u8 = undefined;
    var mem = Mem.as(&buffer);

    // comptime array
    const mat: [2][2]f32 = [
        [ 1.0, 2.0 ],
        [ 3.0, 4.0 ]
    ];

    // init from array
    var tensor = try Tensor.a2(&mem, mat);
    defer tensor.d();

    // verify shape
    try expectEqualSlices(usize, &[2, 2], tensor.shape);

    // verify data
    try expectEqual(tensor.get(&[0, 0]), 1.0);
    try expectEqual(tensor.get(&[1, 1]), 4.0);
    // try tensor.print();
}

test "Tensor: 3D" {
