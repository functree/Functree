}

test "DateTime: toStr" {
    const datetime = try DateTime.parse("2025-01-06 09:05:03");
    var buffer: [30]u8 = undefined;

    const datetime_str = datetime.toStr(&buffer);
    try expectEqualSlices(u8, "2025-01-06 09:05:03", datetime_str);
}
test "DateTime: toStr2" {
    const datetime = try DateTime.parse2("2025-01-06 09:05:03.008", "y-mm-dd hh:ii:ss.ll");
    var buffer: [30]u8 = undefined;

    const datetime_str = try datetime.toStr2(&buffer, "y-mm-dd hh:ii:ss.ll");
    try expectEqualSlices(u8, "2025-01-06 09:05:03.008", datetime_str);

    const datetime_str2 = try datetime.toStr2(&buffer, "y-m-d h:i:s.l");
    try expectEqualSlices(u8, "2025-1-6 9:5:3.8", datetime_str2);

    const datetime_str3 = try datetime.toStr2(&buffer, "y-mm-ddThh:ii:ssZ");
    try expectEqualSlices(u8, "2025-01-06T09:05:03Z", datetime_str3);

    const datetime2 = try DateTime.parse2("2025-01-06 09:05:03.000008", "y-mm-dd hh:ii:ss.uu");

    const datetime_str5 = try datetime2.toStr2(&buffer, "y-mm-dd hh:ii:ss.uu");
    try expectEqualSlices(u8, "2025-01-06 09:05:03.000008", datetime_str5);

    const datetime3 = try DateTime.parse2("2025-01-06 09:05:03.000000008", "y-mm-dd hh:ii:ss.nn");

    const datetime_str6 = try datetime3.toStr2(&buffer, "y-mm-dd hh:ii:ss.nn");
    try expectEqualSlices(u8, "2025-01-06 09:05:03.000000008", datetime_str6);
}

test "DateTime: toTimestamp" {
    const datetime = try DateTime.now();
    const ts = datetime.toTimestamp();
    const ts2 = DateTime.timestamp();

    try expect(ts == ts2);
}
test "DateTime: toMilliTimestamp" {
    const datetime = try DateTime.now2();
    const ts = try datetime.toMilliTimestamp();
    const ts2 = DateTime.milliTimestamp();
    Console.print2("{d}, {d}\n", .{ts, ts2});
    try expect(ts == ts2);
}
test "DateTime: toMicroTimestamp" {
    const datetime = try DateTime.now3();
    const ts = try datetime.toMicroTimestamp();
    const ts2 = DateTime.microTimestamp();
    // Console.print2("{d}, {d}\n", .{ts, ts2});
    try expect(try Math.divFloor(i64, ts, 1000) == try Math.divFloor(i64, ts2, 1000));
}

test "DateTime: timeInterval" {
    const datetime = try DateTime.parse2("2025-01-06 09:05:03.008", "y-mm-dd hh:ii:ss.ll");
    const datetime2 = try DateTime.parse2("2025-01-06 09:05:03.013", "y-mm-dd hh:ii:ss.ll");
    const time_interval = try datetime.timeInterval(datetime2);
    try expect(time_interval.days == 0);
    try expect(time_interval.hours == 0);
    try expect(time_interval.minutes == 0);
    try expect(time_interval.seconds == 0);
    try expect(time_interval.milliseconds == 5);

    const datetime3 = try DateTime.parse2("2025-01-06 09:05:08.000008", "y-mm-dd hh:ii:ss.uu");
    const datetime4 = try DateTime.parse2("2025-01-06 09:05:03.000008", "y-mm-dd hh:ii:ss.uu");
    const time_interval2 = try datetime3.timeInterval(datetime4);
    try expect(time_interval2.days == 0);
    try expect(time_interval2.hours == 0);
    try expect(time_interval2.minutes == 0);
    try expect(time_interval2.seconds == 5);
    try expect(time_interval2.milliseconds == 0);

    const datetime5 = try DateTime.parse2("2025-01-06 09:10:03.000000008", "y-mm-dd hh:ii:ss.nn");
    const datetime6 = try DateTime.parse2("2025-01-06 09:05:03.000000008", "y-mm-dd hh:ii:ss.nn");
    const time_interval3 = try datetime5.timeInterval(datetime6);
    try expect(time_interval3.days == 0);
    try expect(time_interval3.hours == 0);
    try expect(time_interval3.minutes == 5);
    try expect(time_interval3.seconds == 0);
    try expect(time_interval3.milliseconds == 0);
}


const Float = DataType.Float;
test "Float: parse" {
    const d = Float.parse("123.23") catch(err) return err;
    const d2 = Float.parse2(f32, "126.23") catch(err) return err;

    try expect(d==123.23);
    try expect(d2==126.23);
}

test "Float: toStr2" {
    var buffer: [1024]u8 = undefined;

    const float_str = try Float.toStr2(&buffer, 99.38);

    try expect(String.equalStr(float_str, "99.38"));
}

test "Float: minValue maxValue" {
    const d8 = Float.minValue(f16);
    const d9 = Float.maxValue(f16);

    try expect(d8==0.00006104);
    try expect(d9==65500.0);
}


