test "Tensor: concat" {
    // init heap memory
    var mem = Mem.a();
    mem.f();
    defer mem.d();

    var tensor1 = try Tensor.a(&mem, &[2, 2]);
    defer tensor1.d();
    tensor1.set(&[0, 0], 1.0);
    tensor1.set(&[0, 1], 2.0);
    tensor1.set(&[1, 0], 3.0);
    tensor1.set(&[1, 1], 4.0);

    var tensor2 = try Tensor.a(&mem, &[2, 2]);
    defer tensor2.d();
    tensor2.set(&[0, 0], 5.0);
    tensor2.set(&[0, 1], 6.0);
    tensor2.set(&[1, 0], 7.0);
    tensor2.set(&[1, 1], 8.0);

    var mat_c = try Tensor.concat(&[tensor1, tensor2], 0);
    defer mat_c.d();
    Console.print2("\n{s}:\n", .{"Tensor concat, dim=0"});
    try mat_c.print();
    var mat_d = try Tensor.concat(&[tensor1, tensor2], 1);
    defer mat_d.d();
    Console.print2("\n{s}:\n", .{"Tensor concat, dim=1"});
    try mat_d.print();
}
test "Tensor: concat 2" {
    // init heap memory
    var mem = Mem.a();
    mem.f();
    defer mem.d();

    var tensor1 = try Tensor.a(&mem, &[2, 2]);
    defer tensor1.d();
    tensor1.set(&[0, 0], 1.0);
    tensor1.set(&[0, 1], 2.0);
    tensor1.set(&[1, 0], 3.0);
    tensor1.set(&[1, 1], 4.0);

    var tensor2 = try Tensor.a(&mem, &[2, 2]);
    defer tensor2.d();
    tensor2.set(&[0, 0], 5.0);
    tensor2.set(&[0, 1], 6.0);
    tensor2.set(&[1, 0], 7.0);
    tensor2.set(&[1, 1], 8.0);

    var tensor3 = try Tensor.a(&mem, &[2, 2]);
    defer tensor3.d();
    tensor3.set(&[0, 0], 11.0);
    tensor3.set(&[0, 1], 12.0);
    tensor3.set(&[1, 0], 13.0);
    tensor3.set(&[1, 1], 14.0);

