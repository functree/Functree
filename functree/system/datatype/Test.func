            [3.0, 4.0]
        ],
        [
            [5.0, 6.0],
            [7.0, 8.0]
        ]
    ];

    var tensor = try Tensor.a2(&mem, tensor_3d);
    defer tensor.d();

    try expectEqualSlices(usize, &[2, 2, 2], tensor.shape);
    try expectEqual(tensor.get(&[1, 0, 1]), 6.0);
}

test "Tensor: addTensor subTensor mulTensor divTensor powTensor" {
    var buffer: [2000]u8 = undefined;
    var mem = Mem.as(&buffer);

    // 1. 2x2 matrix
    const array1: [2][2]f32 = [
        [ 1.0, 2.0 ],
        [ 3.0, 4.0 ]
    ];
    var mat_a = try Tensor.a2(&mem, array1);
    defer mat_a.d();

    const array2: [2][2]f32 = [
        [5.0, 6.0],
        [7.0, 8.0]
    ];
    var mat_b = try Tensor.a2(&mem, array2);
    defer mat_b.d();

    // 2. addTensor
    var mat_add = try mat_a.addTensor(mat_b);
    defer mat_add.d();
    Console.print2("\n{s}:\n", .{"Tensor addTensor"});
    try mat_add.print(); // Shape: [2, 2], Data: [[6.0, 8.0], [10.0, 12.0]]
    // 3. subTensor
    var mat_sub = try mat_a.subTensor(mat_b);
    defer mat_sub.d();
    Console.print2("\n{s}:\n", .{"Tensor subTensor"});
    try mat_sub.print();
    // 4. mulTensor
    var mat_mul = try mat_a.mulTensor(mat_b);
    defer mat_mul.d();
    Console.print2("\n{s}:\n", .{"Tensor mulTensor"});
    try mat_mul.print();
    // 5. divTensor
    var mat_div = try mat_a.divTensor(mat_b);
    defer mat_div.d();
    Console.print2("\n{s}:\n", .{"Tensor divTensor"});
    try mat_div.print();
    // 5. powTensor
    var mat_pow = try mat_a.powTensor(mat_b);
    defer mat_pow.d();
    Console.print2("\n{s}:\n", .{"Tensor powTensor"});
    try mat_pow.print();
}

