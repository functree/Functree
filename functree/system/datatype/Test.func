test "DateTime: a addMillisecond" {
    var datetime = try DateTime.parse2("2025-01-06 09:05:03.008", "y-mm-dd hh:ii:ss.ll");

    datetime.addMillisecond(-8);
    try expect(datetime.year == 2025);
    try expect(datetime.month == 1);
    try expect(datetime.day == 6);
    try expect(datetime.hour == 9);
    try expect(datetime.minute == 5);
    try expect(datetime.second == 3);
    try expect(datetime.millisecond == 0);

    datetime.addMillisecond(1000);
    try expect(datetime.year == 2025);
    try expect(datetime.month == 1);
    try expect(datetime.day == 6);
    try expect(datetime.hour == 9);
    try expect(datetime.minute == 5);
    try expect(datetime.second == 4);
    try expect(datetime.millisecond == 0);
}

test "DateTime: compare" {
    var datetime = try DateTime.parse("2025-1-6 9:5:8");
    var datetime2 = try DateTime.parse("2025-1-6 9:5:8");
    try expect(datetime.compare(datetime2) == 0);
    datetime2.addDay(-1);
    try expect(datetime.compare(datetime2) == 1);
    datetime2.addDay(2);
    try expect(datetime.compare(datetime2) == -1);
}

test "DateTime: equal" {
    const datetime = try DateTime.parse("2025-1-6 9:5:8");
    var datetime2 = try DateTime.parse("2025-1-6 9:5:8");
    try expect(datetime.equal(datetime2));
    datetime2.addDay(1);
    try expect(!datetime.equal(datetime2));
}

