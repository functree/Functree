test "DateTime: parse" {
    const datetime = try DateTime.parse("2025-1-6 9:5:8");
    try expect(datetime.year == 2025);
    try expect(datetime.month == 1);
    try expect(datetime.day == 6);
    try expect(datetime.hour == 9);
    try expect(datetime.minute == 5);
    try expect(datetime.second == 8);

    const datetime2 = try DateTime.parse("2025-01-06 09:05:03");
    try expect(datetime2.year == 2025);
    try expect(datetime2.month == 1);
    try expect(datetime2.day == 6);
    try expect(datetime2.hour == 9);
    try expect(datetime2.minute == 5);
    try expect(datetime2.second == 3);
}
test "DateTime: parse2" {
    const datetime = try DateTime.parse2("2025-01-06 09:05:03.008", "y-mm-dd hh:ii:ss.ll");
    try expect(datetime.year == 2025);
    try expect(datetime.month == 1);
    try expect(datetime.day == 6);
    try expect(datetime.hour == 9);
    try expect(datetime.minute == 5);
    try expect(datetime.second == 3);
    try expect(datetime.millisecond == 8);

    const datetime2 = try DateTime.parse2("1-6/2025 9:5:3", "m-d/y h:i:s");
    try expect(datetime2.year == 2025);
    try expect(datetime2.month == 1);
    try expect(datetime2.day == 6);
    try expect(datetime2.hour == 9);
    try expect(datetime2.minute == 5);
