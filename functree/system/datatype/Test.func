const Result = DataType.Result;
const FileOpenError = error{
    AccessDenied,
    OutOfMemory,
    FileNotFound,
};
test "Result: t" {
    var result = Result.t(u8, FileOpenError).a();
    if (result.ok()) {
        Console.print("result is undefined.\n");
    }
    result.v(1);
    try expect(result.value == 1);

    var result2 = Result.t(?u8, FileOpenError).a();
    result2.v(1);
    try expect(result2.value.? == 1);
    if (result2.ok()) {
        Console.print("result2 is ok.\n");
    }

    result2.e(FileOpenError.OutOfMemory);
    try expect(result2.err == FileOpenError.OutOfMemory);
    if (!result2.ok()) {
        Console.print("result2 is error.\n");
    }
}


const Char = DataType.Char;
test "Char: isControl isDigit isDigit" {
    try expect(Char.isControl(Char.control_code.del));
    try expect(!Char.isControl(0x80));

    try expect(!Char.isDigit('e'));
    try expect(Char.isDigit('6'));

    try expect(!Char.isLower('Z'));
    try expect(Char.isLower('z'));
}

test "Char: isUtf8Codepoint" {
    try expect(Char.isUtf8Codepoint('e'));
    try expect(Char.isUtf8Codepoint('中'));
}

test "Char: utf8Encode and utf8Decode" {
    const codepoint = try Char.utf8Decode("𐍈");
    const s1 = try Char.utf8Encode(codepoint);

    try expect(codepoint == 66376);
    try expect(s1[0] == 0b11110000);
    try expect(s1[1] == 0b10010000);
    try expect(s1[2] == 0b10001101);
    try expect(s1[3] == 0b10001000);
}

test "Char: getUtf8Iter" {
    var it = try Char.getUtf8Iter("abc");
    while (s1 in it.nextCodepointSlice()) {
        Console.println(s1);
    }
}


