pub fn print(string: str) void {
    std.debug.print("{s}", .{string});
}
pub fn println(string: str) void {
    std.debug.print("{s}\n", .{string});
}
pub fn print2(comptime format: str, args: anytype) void {
    std.debug.print(format, args);
}
