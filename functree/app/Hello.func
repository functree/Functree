//!第一个程序
const System = import("../System.func");
const Mem = System.Mem;
const Console = System.Io.Console;

///程序入口
pub fn main() void {
    Console.print("Hello, world!\n");
}

test "Hello: test" {
    const string = "hello world!\n";
    //Console.print(string);
    Console.print2("format:{s}", .{string});

    // init heap memory
    var mem = Mem.a();
    // set auto free memory
    mem.f();
    defer mem.d();
    _ = Console.a(&mem);
}